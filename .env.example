# ===== Развёртывание (нужны только для docker compose) =====
APP_DOMAIN=kit-queue.example.ru          # домен, A-запись которого указывает на IP машины
ACME_EMAIL=admin@example.ru              # почта для уведомлений Let's Encrypt
POSTGRES_PASSWORD=                       # сгенерировать: openssl rand -base64 24

# ===== Битрикс24 =====
B24_REST_URL=https://ukids-academy.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/
B24_PORTAL=ukids-academy.bitrix24.ru
# Авторизация входящих вебхуков — нужен хотя бы один из двух:
WEBHOOK_SECRET=                          # для робота «Вебхук»: URL робота = https://<домен>/b24/webhook?key=<это значение>
B24_APP_TOKEN=                           # для исходящего вебхука по событию: его «Код авторизации»
# B24_MEMBER_ID=                         # доп. проверка auth[member_id], необязательно
B24_TRIGGER_STAGE_ID=                    # целевая стадия, напр. C0:NEW. Пусто = любая (и сверка не работает)
# B24_CATEGORY_ID=                       # ID воронки, если стадий с одним именем несколько

# ===== Voximplant Kit =====
KIT_DOMAIN=ukids
KIT_ACCESS_TOKEN=
KIT_CAMPAIGN_ID=1576

# ===== Опционально (указаны значения по умолчанию) =====
# WEBHOOK_PATH=/b24/webhook
# B24_EVENTS=ONCRMDEALADD,ONCRMDEALUPDATE
# B24_RPS=2
# B24_POLL_MS=5000
# B24_BATCH_SIZE=4
# KIT_BASE_URL=https://kitapi-ru.voximplant.com
# KIT_TASK_PRIORITY=1
# KIT_TZ_AUTODETECT=true                 # tz_autodetection_enabled: Kit определяет зону по коду номера
# KIT_TIMEZONE=                          # либо фиксированная зона на все строки, напр. Europe/Moscow
# KIT_RPS=2
# KIT_POLL_MS=60000
# KIT_CHUNK_SIZE=100
# KIT_MAX_PER_TICK=1000
# RECONCILE_ENABLED=true                 # сверка: подбирает сделки, чьи вебхуки не дошли
# RECONCILE_POLL_MS=900000               # как часто сверять (по умолчанию 15 мин)
# RECONCILE_LOOKBACK_MIN=120             # за какой период смотреть изменённые сделки
# RECONCILE_MAX_PAGES=20                 # предохранитель: максимум 20 x 50 = 1000 сделок за цикл
# RECONCILE_RECHECK_MIN=60               # как часто перепроверять сделки со статусом skipped/ошибка
# MAX_ATTEMPTS=8
# RETRY_BASE_SEC=30
# RETRY_MAX_SEC=1800
# RETENTION_DAYS=30
# HTTP_TIMEOUT_MS=15000

# Запуск без Docker (npm run dev): вместо POSTGRES_PASSWORD задайте
# DATABASE_URL=postgres://user:password@localhost:5432/b24kit
